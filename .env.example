# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123
POSTGRES_DB=stockprediction
DATABASE_URL=postgresql://stockuser:CHANGE_THIS_SECURE_PASSWORD_123@postgres:5432/stockprediction

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_456@redis:6379/0

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG_abcdefghijklmnop
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS CONFIGURATION
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ==========================================
# EXTERNAL API KEYS
# ==========================================
# NewsAPI for sentiment analysis (get from: https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage for market data (get from: https://www.alphavantage.co/)
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# Twitter API for sentiment (optional)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ==========================================
# EMAIL CONFIGURATION (for alerts)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@stockpred.com
SMTP_TLS=true

# ==========================================
# SMS CONFIGURATION (Twilio - optional)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# MONITORING & ADMIN
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

PGADMIN_EMAIL=admin@stockpred.com
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==========================================
# MODEL CONFIGURATION
# ==========================================
MODELS_DIR=/app/models
DEFAULT_MODEL_TYPE=gru
USE_ATTENTION=true
DEFAULT_EPOCHS=50
DEFAULT_BATCH_SIZE=64
DEFAULT_LEARNING_RATE=0.001

# ==========================================
# SUBSCRIPTION LIMITS
# ==========================================
# Free tier
FREE_API_CALLS_LIMIT=100
FREE_PREDICTIONS_PER_DAY=10

# Premium tier
PREMIUM_API_CALLS_LIMIT=10000
PREMIUM_PREDICTIONS_PER_DAY=1000

# Enterprise tier
ENTERPRISE_API_CALLS_LIMIT=100000
ENTERPRISE_PREDICTIONS_PER_DAY=unlimited

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# AWS S3 for backups (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BACKUP_BUCKET=your-backup-bucket-name
AWS_REGION=us-east-1

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_PORTFOLIO_TRACKING=true
ENABLE_PRICE_ALERTS=true
ENABLE_SOCIAL_TRADING=false

# ==========================================
# CACHE CONFIGURATION
# ==========================================
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# ==========================================
# WORKER CONFIGURATION
# ==========================================
CELERY_BROKER_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_456@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_REDIS_PASSWORD_456@redis:6379/0
CELERY_WORKERS=4

# ==========================================
# TIMEZONE
# ==========================================
TZ=UTC